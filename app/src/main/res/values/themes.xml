<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: no action bar, Compose drives everything. -->
    <style name="Theme.Focuss" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Blocking overlay activity theme. -->
    <style name="Theme.Focuss.Blocking" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
